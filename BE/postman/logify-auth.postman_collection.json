{
  "info": {
    "_postman_id": "8e7e263b-3dfc-4cb0-a19a-7f8f7e789001",
    "name": "Logify Auth API",
    "description": "Automated auth tests based on .github/instruction/02-requirements.md and 07-testing.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "registerUsername", "value": "" },
    { "key": "registerEmail", "value": "" },
    { "key": "password", "value": "Password123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Register - success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('registerUsername', `user_${Date.now()}`);",
              "pm.collectionVariables.set('registerEmail', `user_${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('returns HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('uses RestResponse format', () => { pm.expect(body.statusCode).to.eql(201); pm.expect(body.error).to.be.null; pm.expect(body.data).to.be.an('object'); });",
              "pm.test('returns public user data', () => { pm.expect(body.data.username).to.eql(pm.collectionVariables.get('registerUsername')); pm.expect(body.data.email).to.eql(pm.collectionVariables.get('registerEmail')); pm.expect(body.data).to.not.have.property('password'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"termsAgreement\": true\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - duplicate username",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 409', () => pm.response.to.have.status(409));",
        "pm.test('returns username conflict', () => { pm.expect(body.statusCode).to.eql(409); pm.expect(body.error).to.eql('Conflict'); pm.expect(body.message).to.eql('Username already exists'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"email\": \"another_{{$timestamp}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"termsAgreement\": true\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - duplicate email",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 409', () => pm.response.to.have.status(409));",
        "pm.test('returns email conflict', () => { pm.expect(body.statusCode).to.eql(409); pm.expect(body.message).to.eql('Email already exists'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"new_{{$timestamp}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"termsAgreement\": true\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - validation rules",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('returns HTTP 422 for invalid payload', () => pm.response.to.have.status(422));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"ab\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"confirmPassword\": \"different\",\n  \"termsAgreement\": false\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - invalid email",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('returns HTTP 422', () => pm.response.to.have.status(422));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"invalid_email_{{$timestamp}}\",\n  \"email\": \"invalid-email\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"termsAgreement\": true\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - password mismatch",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('returns HTTP 422', () => pm.response.to.have.status(422));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"mismatch_{{$timestamp}}\",\n  \"email\": \"mismatch_{{$timestamp}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"Different123\",\n  \"termsAgreement\": true\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login - empty fields",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('returns HTTP 422', () => pm.response.to.have.status(422));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - success",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('returns access and refresh tokens', () => { pm.expect(body.statusCode).to.eql(200); pm.expect(body.data.access_token).to.be.a('string').and.not.empty; pm.expect(body.data.refresh_token).to.be.a('string').and.not.empty; });",
        "pm.collectionVariables.set('accessToken', body.data.access_token);",
        "pm.collectionVariables.set('refreshToken', body.data.refresh_token);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"password\": \"{{password}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - wrong password",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 400', () => pm.response.to.have.status(400));",
        "pm.test('returns invalid credentials', () => { pm.expect(body.statusCode).to.eql(400); pm.expect(body.message).to.eql('Invalid username or password'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"password\": \"WrongPassword123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Get current user - /me",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('returns authenticated user', () => { pm.expect(body.statusCode).to.eql(200); pm.expect(body.data.username).to.eql(pm.collectionVariables.get('registerUsername')); });"
      ] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "Refresh access token - /access",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('returns a new access token', () => { pm.expect(body.statusCode).to.eql(200); pm.expect(body.data.access_token).to.be.a('string').and.not.empty; });",
        "pm.collectionVariables.set('accessToken', body.data.access_token);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/auth/access"
      }
    },
    {
      "name": "Logout",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('returns logout response', () => { pm.expect(body.statusCode).to.eql(200); pm.expect(body.data).to.be.null; });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "Access after logout - revoked token",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('returns HTTP 401', () => pm.response.to.have.status(401));",
        "pm.test('rejects revoked refresh token', () => { pm.expect(body.statusCode).to.eql(401); pm.expect(body.error).to.eql('Unauthorized'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/auth/access"
      }
    }
  ]
}
